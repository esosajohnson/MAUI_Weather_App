<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherApp_CW.Views.YourLocationsView"
             xmlns:vm="clr-namespace:WeatherApp.Core.ViewModels;assembly=WeatherApp.Core"
             x:DataType="vm:YourLocationsViewModel"
             xmlns:models="clr-namespace:WeatherApp.Core.Models;assembly=WeatherApp.Core"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Name="YourLocationsPage"
             Shell.BackgroundColor="MidnightBlue"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White"
             Shell.NavBarHasShadow="False"
             Title="Your Locations">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label Text="Add a Location" FontSize="22" />
                <Entry Placeholder="Search city..." Text="{Binding SearchQuery}" TextColor="White"/>
                <Button Text="Save Location" Command="{Binding SaveLocationCommand}" />

                <CollectionView ItemsSource="{Binding SavedLocations}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="5"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SavedLocation">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem
                                            Text="Delete"
                                            BackgroundColor="Red"
                                            Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:YourLocationsViewModel}}, x:DataType=vm:YourLocationsViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid>
                                    <Border Style="{StaticResource locationCards}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                    </Border>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" Margin="8">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Start"/>
                                            <Label Text="{Binding DisplayTemperature, StringFormat='Temp: {0}'}" HorizontalOptions="Start"/>
                                            <Label Text="{Binding UpdatedAt, StringFormat='Updated: {0:MMMM dd, HH:mm}'}" HorizontalOptions="Start"/>
                                        </VerticalStackLayout>

                                        <skia:SKLottieView 
                                            HeightRequest="70" 
                                            WidthRequest="70" 
                                            Source="{Binding WeatherCode, Converter={StaticResource WeatherAnimationConverter}}"
                                            RepeatCount="-1" 
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"/>
                                    </Grid>
                                </Grid>
                            </SwipeView>
                        </DataTemplate>

                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
        
    </RefreshView>
    

</ContentPage>