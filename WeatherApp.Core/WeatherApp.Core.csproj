<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-independent app logic: models, services and view models.
       No MAUI dependency, so everything here can be unit tested on any machine. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>WeatherApp.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FirebaseAuthentication.net" Version="3.7.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <!-- Not used directly: overrides the vulnerable 11.0.2 that FirebaseAuthentication.net depends on (GHSA-5crp-9r3c-p9vr) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WeatherApp.Core.Tests" />
  </ItemGroup>

</Project>
